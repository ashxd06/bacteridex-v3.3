# Copia este archivo a .env.local (en tu computadora) y en Vercel agrega las
# mismas variables en Project Settings → Environment Variables.
# Sin estas variables, BacteriDex sigue funcionando normalmente como
# enciclopedia pública; solo las funciones de cuenta y BacteriDex Study
# quedan desactivadas.

# --- Cuentas de usuario (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# --- BacteriDex Study (análisis de PDFs con IA) ---
# SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API → service_role.
# SOLO se usa en el servidor (app/api/study/analizar/route.ts). NUNCA la
# agregues con el prefijo NEXT_PUBLIC_ ni la uses en componentes de cliente.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# BacteriDex Study puede usar 3 proveedores de IA. Configura al menos uno;
# el modo "Automático" prueba Claude → Gemini → OpenAI y salta los que no
# tengan clave configurada. Todas son SOLO de servidor, nunca NEXT_PUBLIC_.

# ANTHROPIC_API_KEY: console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=TU_CLAVE_DE_ANTHROPIC

# GEMINI_API_KEY: aistudio.google.com/app/apikey
GEMINI_API_KEY=TU_CLAVE_DE_GEMINI

# OPENAI_API_KEY: platform.openai.com/api-keys
OPENAI_API_KEY=TU_CLAVE_DE_OPENAI

# Opcional: cambia el modelo usado por cada proveedor si lo necesitas.
# STUDY_AI_MODEL=claude-sonnet-5
# STUDY_AI_MODEL_GEMINI=gemini-2.0-flash
# STUDY_AI_MODEL_OPENAI=gpt-4o
